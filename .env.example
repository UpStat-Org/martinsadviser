# Frontend env. Every VITE_* var is inlined into the client bundle at build
# time — treat all of them as public. Anything that must stay secret belongs in
# Supabase Edge Function secrets (see the list at the bottom), never here.
#
# Copy to `.env` and fill in. `.env` is gitignored.

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ---------------------------------------------------------------------------
# Backend secrets — NOT set here. These live in the Supabase dashboard under
# Edge Functions → Secrets. Listed so the required set is discoverable:
#
#   GROQ_API_KEY             ai-chat, ai-draft, ai-report (via _shared/ai.ts)
#   AI_MODEL                 model id, e.g. openai/gpt-oss-120b
#   AI_BASE_URL              optional — defaults to https://api.groq.com/openai/v1.
#                            Any OpenAI-compatible provider works.
#   NETLIFY_AUTH_TOKEN       sync-netlify-domains
#   NETLIFY_SITE_ID          sync-netlify-domains
#   RESEND_API_KEY           send-emails, send-invitation-email, create-portal-user
#   STRIPE_SECRET_KEY        stripe-checkout, stripe-billing-portal, stripe-webhook
#   STRIPE_WEBHOOK_SECRET    stripe-webhook
#   STRIPE_PRICE_ID          stripe-checkout
#   GOOGLE_CLIENT_ID         google-calendar-auth, -callback, -sync
#   GOOGLE_CLIENT_SECRET     google-calendar-callback, google-calendar-sync
#   FMCSA_WEB_KEY            fmcsa-lookup, fmcsa-monitor
#   PORTAL_ENCRYPTION_KEY    create-portal-user, redeem-portal-token (min 16 chars)
#   ELD_ENCRYPTION_KEY       eld-connect, eld-sync (min 16 chars)
#   PILOTSTATUS_API_KEY      send-emails (WhatsApp channel)
#   PILOTSTATUS_API_URL      optional — defaults to https://pilotstatus.online/api/v1
#   APP_URL                  defaults to https://dotpilot.online
#   SITE_URL                 google-calendar-callback redirect target
#   EMAIL_FROM               send-emails
#   INVITATION_EMAIL_FROM    send-invitation-email, create-portal-user
#
# Vault secrets required for the pg_cron jobs to register at all:
#   project_functions_url, service_role_key
# ---------------------------------------------------------------------------
